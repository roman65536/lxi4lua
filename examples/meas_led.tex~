  function meas(con,file,max_v,max_i)
  call_scpi(dev,":POWERS:OUTP1 ON")
  for v=1,max_v,.1 do
  call_scpi(con,string.format(":POWERS:OUTP1:VOLT %.1f",v))
     lxi_sleep(1)
     val=tonumber(lxi_scpi(con,":DMM:VALue?"))
     if val > max_i then
     lxi_scpi(con,":POWERS:OUTP1 OFF")
     return
     end
     print(string.format("V %.1f I %f A\n",v,val))
     file:write(string.format("V %.1f I %f A\n",v,val))
     --lxi_sleep(1)
  end
  call_scpi(con,":POWERS:OUTP1 OFF")
  call_scpi(con,string.format(":POWERS:OUTP1:VOLT 0"))
  end

  

 function conv_m(text)

 text=string.gsub(text,"&#39","\\verb|'|")
 text=string.gsub(text,"&#40","(")
 text=string.gsub(text,"&#41",")")
 text=string.gsub(text,"&","\\verb|&|")
 text=string.gsub(text,"#","\\verb|#|")
 text=string.gsub(text,"_","\\textunderscore{}")
 --text=string.gsub(text,"^","\\verb|^|")
 text=string.gsub(text,"/","/\\allowbreak{}")
 --text=string.gsub(text,"%c","")
 test=string.gsub(text,"\026","")

return text
end


function split_string(inputstr, sep)
    if sep == nil then
        sep = "%s"
    end
    local t = {}
    for part in string.gmatch(inputstr, "([^" .. sep .. "]+)") do
        table.insert(t, part)
    end
    return t
end

function text_prompt(msg)
  io.write(msg)
  io.flush()
  return io.read()
end

function call_scpi(con,msg)
lxi_scpi(con,msg)
err_msg=lxi_scpi(con,"SYSTem:ERRor?")
print(err_msg)
end

